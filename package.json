{
  "name": "portfolio-forge",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:offline": "REL_ASSETS=1 next build && node scripts/make-offline-html.mjs",
    "build:docs": "node scripts/build-docs-app.mjs",
    "serve": "npx --yes serve@14 out -l 3000",
    "preview": "npm run build:offline && npm run serve",
    "check": "node scripts/check-export.mjs",
    "lint": "next lint"
  },
  "keywords": [
    "markdown",
    "portfolio",
    "resume",
    "nextjs",
    "tailwind",
    "github-pages",
    "static-site"
  ],
  "author": "",
  "license": "MIT",
  "description": "Markdown in, hosted developer portfolio out — a static Next.js studio that turns a .md résumé into a themed, GitHub-Pages-ready site.",
  "dependencies": {
    "jszip": "^3.10.2",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.13"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/<your-user>/portfolio-forge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-user>/portfolio-forge.git"
  },
  "bugs": {
    "url": "https://github.com/<your-user>/portfolio-forge/issues"
  }
}
